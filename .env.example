# MySQL on GoDaddy. Use the FULL cPanel-prefixed user and database names,
# and URL-encode special characters in the password (@ -> %40, # -> %23,
# / -> %2F, : -> %3A, % -> %25).
# connection_limit=1 keeps each Vercel function to a single connection,
# which matters because GoDaddy shared hosting caps connections per user.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME?connection_limit=1&connect_timeout=10"

# Long random string; required as the x-health-check-secret header for
# GET /api/db-health in production. Generate with: openssl rand -hex 32
DB_HEALTH_SECRET=

# Google reCAPTCHA v2 checkbox keys (google.com/recaptcha/admin). The site's
# domain and localhost must be listed under the key's allowed domains.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Resend (resend.com) for notification emails. CONTACT_FROM_EMAIL must use a
# domain verified in Resend, e.g. "Lowell Edwards <info@lowelledwards.com>".
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
